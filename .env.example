# Serverless Edge Database (For optional v2.0 global guestbook sync)
# DATABASE_URL=postgresql://lumo_user:change_me@edge.db:5432/lumo_production
# CLOUDFLARE_D1_BINDING=DB

# Cryptographic Salt for Privacy-Preserving IP Rate Limiting (Edge only)
# IP_HASH_SALT=example_secret_salt_for_rate_limiting_do_not_commit

# Administrative Content Moderation Token (Edge only)
# ADMIN_SECRET_KEY=example_admin_secret_token_for_moderation

# Local Development Port (Default: 8080)
PORT=8080
